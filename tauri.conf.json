{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVoiceDesktop",
  "version": "0.1.0",
  "identifier": "com.openvoice.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "OpenVoiceDesktop Settings",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
