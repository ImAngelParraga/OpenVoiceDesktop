{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVoiceDesktop",
  "identifier": "com.openvoice.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "OpenVoiceDesktop Settings",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "OpenVoiceDesktop Overlay",
        "width": 210,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenVoiceDesktop",
    "homepage": "https://github.com/ImAngelParraga/OpenVoiceDesktop",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English"],
        "startMenuFolder": "OpenVoiceDesktop",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
