{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVoiceDesktop",
  "version": "0.1.0",
  "identifier": "com.openvoice.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "OpenVoiceDesktop Settings",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "OpenVoiceDesktop Overlay",
        "width": 420,
        "height": 88,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
